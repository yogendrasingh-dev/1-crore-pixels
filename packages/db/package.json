{
  "name": "@1crore-pixels/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@1crore-pixels/config": "workspace:*",
    "@types/node": "26.4.1",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
