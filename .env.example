# Copy to .env and fill in real values. Never commit .env.
# See docs/DEPLOYMENT.md §3.

NODE_ENV=development

# --- Database — docs/DATABASE.md, packages/db ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/one_crore_pixels?schema=public"

# --- Redis-compatible store — rate limiting (docs/SECURITY.md §3), Phase 3 job queue (docs/ARCHITECTURE.md §10) ---
REDIS_URL="redis://localhost:6379"

# --- Payment provider selection — docs/PAYMENT.md §4.3 ---
# manual = ManualUpiProvider (MVP). gateway = GatewayProvider (Phase 3, not implemented yet).
PAYMENT_PROVIDER="manual"

# --- ManualUpiProvider config — docs/PAYMENT.md §4.1 ---
UPI_VPA="campaign@upi"
UPI_PAYEE_NAME="1 Crore Pixels"

# --- Phase 3 placeholder — payment gateway webhook signature verification. Unused until Phase 12. ---
PAYMENT_WEBHOOK_SIGNING_SECRET=""

# --- Admin auth — docs/SECURITY.md §5 ---
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret-min-32-chars"
MFA_ENCRYPTION_KEY="replace-with-a-long-random-secret-min-32-chars"

# --- Pixel wall geometry — frozen once real allocations exist (CLAUDE.md §9, docs/PIXEL_SYSTEM.md §3) ---
PIXEL_WALL_WIDTH="4000"
PIXEL_CHUNK_ROWS="25"
